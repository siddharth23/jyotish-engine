{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YOUR-GITHUB-USERNAME/jyotish-engine/blob/main/packages/rules/schema/rule-set.schema.json",
  "title": "Jyotish rule set",
  "description": "A versioned collection of predicates evaluated against a computed chart. Contains identifiers and conditions only; interpretation text belongs in the consuming application.",
  "type": "object",
  "required": [
    "version",
    "name",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version. Must be recorded alongside any analysis this rule set produces."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Classical text or expert attribution for this rule set as a whole."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$",
          "description": "Stable identifier. The consuming application maps this to display text."
        },
        "source": {
          "type": "string",
          "description": "Classical citation, e.g. 'Brihat Parashara Hora Shastra, ch. 34'."
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "cancelledBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rule ids which, if also matched, cancel this one."
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "subject",
        "operator",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "chart": {
          "type": "string",
          "enum": [
            "d1",
            "d2",
            "d3",
            "d7",
            "d9",
            "d10",
            "d12"
          ],
          "default": "d1"
        },
        "subject": {
          "type": "string",
          "description": "Dotted path into the chart, e.g. 'positions.saturn.house'."
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "notEquals",
            "in",
            "notIn",
            "greaterThan",
            "lessThan",
            "between"
          ]
        },
        "value": {
          "description": "Comparison operand. Type depends on the operator."
        }
      }
    }
  }
}
